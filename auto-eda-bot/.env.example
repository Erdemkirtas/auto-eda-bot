# Auto-EDA Bot — Ortam Değişkenleri (Şablon)
# =============================================
# Bu dosyayı `.env` olarak kopyalayın ve kendi sisteminize göre düzenleyin:
#   cp .env.example .env

# Yerel LLM Ayarları (Ollama veya Foundry Local)
LOCAL_LLM_API_BASE=http://localhost:11434/v1
LOCAL_LLM_MODEL=phi3:mini
LOCAL_LLM_TEMPERATURE=0.0

# Uygulama Ayarları
BACKEND_PORT=8000
MAX_REPL_TIMEOUT=30
MAX_OUTPUT_LENGTH=15000

# Kalıcı Hafıza (SQLite)
MEMORY_DB_PATH=data/memory.db
